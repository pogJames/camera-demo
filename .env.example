# Copy to .env and adjust. Loaded by systemd (EnvironmentFile) on the board,
# or `set -a; . ./.env; set +a` for a manual run.

# --- Video source ---------------------------------------------------------
# Dev box: the mock server (see mock_server.py).
STREAM_URL=http://localhost:8080/mock.mjpeg
# Board: the real IDS uEye MJPEG endpoint, e.g.
# STREAM_URL=https://192.168.1.170/streaming/stream3/video.mjpeg

# --- Model ----------------------------------------------------------------
# Default: INT8 built-in-postprocess model (4 outputs, NPU-ready). The app
# auto-detects the branch (4 outputs = built-in postprocess, 2 = raw + priors).
MODEL_PATH=tflite_model/ssd_mobilenet_v2_coco_quant_postprocess.tflite
# Board: Vela-compile the above INT8 model, then point here:
# MODEL_PATH=/opt/npu/tflite_model/ssd_mobilenet_v2_coco_quant_postprocess_vela.tflite
# Older float model (CPU only, 2-output raw path) still works if you prefer:
# MODEL_PATH=tflite_model/ssd_mobilenet_v2_coco.tflite

LABELS_PATH=tflite_model/coco_labels_list.txt
PRIORS_PATH=tflite_model/box_priors.txt   # used only by the 2-output raw model

# Class-id -> labels-file offset. Empty = branch default (built-in postprocess
# +1 because it drops background; raw model 0). Override only for an odd pairing.
LABEL_OFFSET=

# --- Runtime --------------------------------------------------------------
# 0 = CPU (dev box), 1 = load Ethos-U delegate (board). MUST be 1 for _vela.tflite.
USE_NPU=0
# Run inference on every Nth captured frame; reuse detections in between.
# TUNE THIS ON THE BOARD, not the dev box.
INFER_EVERY=3
SCORE_THRES=0.5
NMS_IOU=0.45
MAX_DETS=50

# Input normalization: norm = (pixel - INPUT_MEAN) / INPUT_STD, applied before
# the model's own dtype/quantization (auto-detected from the model). Defaults
# are SSD-MobileNet's [-1,1]. The INT8/_vela swap needs NO change here unless the
# quantized model was trained with different normalization. Raw [0,255]: MEAN=0 STD=1.
INPUT_MEAN=127.5
INPUT_STD=127.5

# --- Camera auth (board only) --------------------------------------------
CAM_USER=
CAM_PASS=
# 0 = do not verify TLS (self-signed camera cert on an isolated link).
VERIFY_TLS=0

# --- HTTP server ----------------------------------------------------------
HTTP_PORT=8000
JPEG_QUALITY=80

# Decode camera JPEGs at reduced scale to cut A55 decode+encode cost.
# 1=full, 2=half (720p->640x360), 4=quarter. On a 720p stream, 2 is a big win
# and the model (300x300 input) loses nothing. Bump JPEG_QUALITY down to ~70 too.
CAPTURE_REDUCE=1
